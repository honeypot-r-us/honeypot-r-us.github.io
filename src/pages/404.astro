---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
  title="Wrong door"
  description="The requested Honeypot R Us page does not exist."
>
  <header class="page-hero">
    <div class="shell">
      <p class="eyebrow">404 · Wrong door</p>
      <h1>This one is a decoy for lost URLs.</h1>
      <p class="lead">
        Nothing sensitive is behind it. Return to the platform or read how real
        decoys turn unexpected interaction into reviewable evidence.
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/">Return home</a>
        <a class="button button-secondary" href="/honeypots/">Explore honeypots</a>
      </div>
    </div>
  </header>
</SiteLayout>
